{
  "name": "xyte",
  "version": "0.1.0",
  "description": "A Zyte API-compatible /v1/extract client that runs on any proxy provider (Oxylabs, Bright Data, Decodo, IPRoyal, ZenRows, ScrapingBee, ScraperAPI…) or none.",
  "keywords": ["zyte", "zyte-api", "scraping", "web-scraping", "proxy", "residential-proxy", "oxylabs", "brightdata", "playwright"],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "xyte": "./dist/cli.mjs"
  },
  "files": ["dist", "spec", "docs"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun --bun tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "bun test",
    "test:node": "bun run build && node --test test/node/smoke.mjs",
    "test:live": "bun run build && bun scripts/live.ts",
    "gen:types": "bun scripts/gen-types.ts && bun scripts/gen-schemas.ts && bun scripts/coverage.ts",
    "docs:coverage": "bun scripts/coverage.ts",
    "prepublishOnly": "bun run typecheck && bun test && bun run test:node"
  },
  "peerDependencies": {
    "playwright": ">=1.40",
    "undici": ">=7"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "undici": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "oxc-parser": "^0.155.0",
    "patchright": "^1.64.1",
    "playwright": "^1.64.1",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "undici": "^8.12.3"
  }
}
