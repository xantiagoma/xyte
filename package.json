{
  "name": "@xtandard/xyte",
  "version": "0.1.3",
  "description": "A Zyte API-compatible /v1/extract client that runs on any proxy provider (Oxylabs, Bright Data, Decodo, IPRoyal, ZenRows, ScrapingBee, ScraperAPI…) or none.",
  "keywords": [
    "zyte",
    "zyte-api",
    "scraping",
    "web-scraping",
    "proxy",
    "residential-proxy",
    "oxylabs",
    "brightdata",
    "playwright"
  ],
  "license": "MIT",
  "author": "Santiago Montoya <xantiagoma@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xantiagoma/xyte.git"
  },
  "homepage": "https://me.xantiagoma.com/xyte/",
  "bugs": {
    "url": "https://github.com/xantiagoma/xyte/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "xyte": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "docs",
    "!docs/assets",
    "!docs/.vitepress",
    "!docs/index.md",
    "!docs/guide.md",
    "!docs/about.md",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun --bun tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "bun test",
    "test:node": "bun run build && node --test test/node/smoke.mjs",
    "test:live": "bun run build && bun scripts/live.ts",
    "gen:types": "bun scripts/gen-types.ts && bun scripts/gen-schemas.ts && bun scripts/coverage.ts",
    "docs:coverage": "bun scripts/coverage.ts",
    "docs:api": "bun scripts/api-docs.ts",
    "site:dev": "vitepress dev docs",
    "site:build": "vitepress build docs",
    "site:preview": "vitepress preview docs",
    "release": "changelogen --release --push",
    "prepublishOnly": "bun run typecheck && bun test && bun run test:node"
  },
  "peerDependencies": {
    "playwright": ">=1.40",
    "undici": ">=7"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "undici": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "changelogen": "^0.6.2",
    "express": "^5.3.0",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "oxc-parser": "^0.155.0",
    "patchright": "^1.64.1",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "undici": "^8.12.3",
    "vitepress": "1.6.4"
  }
}
